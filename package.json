{
  "name": "cafeflow-backend",
  "version": "1.0.0",
  "description": "Backend de CaféFlow construido con Node.js y Express.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "npm run test:integration",
    "test:unit": "jest --runInBand tests/unit --coverage --coverageDirectory=coverage/unit",
    "test:integration": "node tests/integration/run.js",
    "test:api": "node scripts/run-api-tests.js",
    "seed:test-admin": "node scripts/seed-test-admin.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marlon1054xD/cafeflow-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Marlon1054xD/cafeflow-backend/issues"
  },
  "homepage": "https://github.com/Marlon1054xD/cafeflow-backend#readme",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "newman": "^6.2.3",
    "supertest": "^7.3.1"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageDirectory": "coverage"
