{
  "info": {
    "_postman_id": "9927cac2-b73e-4922-a004-8b5a2c6965e2",
    "name": "CafeFlow API",
    "description": "Pruebas contractuales para las rutas integradas de salud, autenticación y usuarios. Registro, login de cliente y permisos se pueden ejecutar en una base de pruebas aislada. El caso de token vencido queda desactivado porque requiere un JWT expirado firmado con el secreto local de pruebas. El umbral inicial de respuesta es 2000 ms; no es un SLA.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Tiempo de respuesta dentro de maxResponseTimeMs', function () {",
          "  const limit = Number(pm.environment.get('maxResponseTimeMs'));",
          "  pm.expect(limit).to.be.a('number').and.greaterThan(0);",
          "  pm.expect(pm.response.responseTime).to.be.at.most(limit);",
          "});",
          "pm.test('Respuesta con contenido JSON', function () {",
          "  pm.expect(pm.response.headers.get('Content-Type') || '').to.match(/application\\/json/i);",
          "});",
          "pm.test('No se exponen contraseñas ni hashes', function () {",
          "  const forbidden = ['password', 'passwordHash', 'password_hash', 'hash'];",
          "  function inspect(value) {",
          "    if (Array.isArray(value)) return value.forEach(inspect);",
          "    if (value && typeof value === 'object') Object.keys(value).forEach(function (key) {",
          "      pm.expect(forbidden).not.to.include(key);",
          "      inspect(value[key]);",
          "    });",
          "  }",
          "  inspect(pm.response.json());",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Salud",
      "item": [
        {
          "name": "Estado de salud",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/salud"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Salud responde HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Salud informa estado ok', function () { pm.expect(pm.response.json()).to.have.property('estado', 'ok'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Registrar usuario único",
          "description": "POST /api/auth/register { nombre, email, password }. Crea un cliente con correo único en cada ejecución. Ejecútalo solo contra una base aislada para pruebas.",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stamp = Date.now();",
                  "pm.environment.set('email', `cafeflow-${stamp}-${Math.random().toString(36).slice(2, 8)}@example.test`);",
                  "pm.environment.set('nombre', `Usuario de prueba ${stamp}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registro responde HTTP 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Registro devuelve un perfil público sin contraseña', function () {",
                  "  const user = pm.response.json().user;",
                  "  pm.expect(user).to.be.an('object');",
                  "  ['id', 'nombre', 'email', 'rol'].forEach(function (key) { pm.expect(user).to.have.property(key); });",
                  "  pm.expect(user.rol).to.eql('cliente');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{nombre}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Registro duplicado",
          "description": "Requiere ejecutar primero el registro anterior con el mismo email.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Duplicado responde HTTP 409', function () { pm.response.to.have.status(409); });",
                  "pm.test('Error contiene message', function () { pm.expect(pm.response.json().message).to.be.a('string'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{nombre}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Registro con datos inválidos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Validación responde HTTP 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('Error contiene message', function () { pm.expect(pm.response.json().message).to.be.a('string'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"\",\n  \"email\": \"invalido\",\n  \"password\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login incorrecto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Credenciales incorrectas responden HTTP 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('Error contiene message', function () { pm.expect(pm.response.json().message).to.be.a('string'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"clave-incorrecta\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login válido",
          "description": "Contrato integrado: { access_token, user: { id, nombre, email, rol } }. Ejecutar después del registro único para capturar accessToken.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login responde HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Login devuelve el contrato acordado y captura access_token', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.access_token).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.user).to.be.an('object');",
                  "  ['id', 'nombre', 'email', 'rol'].forEach(function (key) { pm.expect(body.user).to.have.property(key); });",
                  "  pm.expect(['cliente', 'admin']).to.include(body.user.rol);",
                  "  pm.environment.set('accessToken', body.access_token);",
                  "  pm.environment.set('userId', body.user.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Usuarios y permisos",
      "item": [
        {
          "name": "GET perfil sin token",
          "description": "GET /api/usuarios/me requiere autenticación.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Sin token responde HTTP 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('Error contiene message', function () { pm.expect(pm.response.json().message).to.be.a('string'); });"
                ]
              }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/usuarios/me" }
        },
        {
          "name": "GET perfil con token inválido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Token inválido responde HTTP 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('Error contiene message', function () { pm.expect(pm.response.json().message).to.be.a('string'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer token-invalido" }],
            "url": "{{baseUrl}}/api/usuarios/me"
          }
        },
        {
          "name": "PENDIENTE - GET perfil con token vencido",
          "description": "Requiere ingresar expiredToken firmado y expirado con el JWT_SECRET de un ambiente local aislado. No se genera un JWT falso ni se usan secretos reales.",
          "disabled": true,
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Token vencido responde HTTP 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('Error contiene message', function () { pm.expect(pm.response.json().message).to.be.a('string'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{expiredToken}}" }],
            "url": "{{baseUrl}}/api/usuarios/me"
          }
        },
        {
          "name": "GET perfil con token válido",
          "description": "Depende del login válido anterior, que guarda accessToken.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Perfil responde HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Perfil devuelve un objeto JSON', function () { pm.expect(pm.response.json()).to.be.an('object'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/usuarios/me"
          }
        },
        {
          "name": "GET lista de usuarios con rol cliente",
          "description": "El token de registro/login es de rol cliente; esta ruta requiere admin y debe responder 403.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cliente sin permisos responde HTTP 403', function () { pm.response.to.have.status(403); });",
                  "pm.test('Error contiene message', function () { pm.expect(pm.response.json().message).to.be.a('string'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/usuarios"
          }
        }
      ]
    },
    {
      "name": "Módulos",
      "description": "No hay otros módulos funcionales documentados en el proyecto."
    }
  ]
}
