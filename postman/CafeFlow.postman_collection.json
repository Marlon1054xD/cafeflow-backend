              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "PENDIENTE - Login incorrecto",
          "description": "El HTTP 401 esperado debe confirmarse con el equipo.",
          "disabled": true,
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Credenciales incorrectas responden HTTP 401 (por confirmar)', function () { pm.response.to.have.status(401); });",
                  "pm.test('Error contiene message', function () { pm.expect(pm.response.json().message).to.be.a('string'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"clave-incorrecta\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "PENDIENTE - Login válido",
          "description": "Contrato acordado: { access_token, user: { id, nombre, email, rol } }, rol cliente o admin. El caso depende de que Luis implemente la ruta y de ejecutar el registro en la misma colección.",
          "disabled": true,
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login responde HTTP 200 (por confirmar)', function () { pm.response.to.have.status(200); });",
                  "pm.test('Login devuelve el contrato acordado y captura access_token', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.access_token).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.user).to.be.an('object');",
                  "  ['id', 'nombre', 'email', 'rol'].forEach(function (key) { pm.expect(body.user).to.have.property(key); });",
                  "  pm.expect(['cliente', 'admin']).to.include(body.user.rol);",
                  "  pm.environment.set('accessToken', body.access_token);",
                  "  pm.environment.set('userId', body.user.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
