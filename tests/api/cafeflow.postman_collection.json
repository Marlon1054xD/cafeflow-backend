{
  "info": {
    "_postman_id": "d83ca123-94ba-4c5f-9f63-cafeflow-scrum21",
    "name": "CaféFlow API",
    "description": "Pruebas contractuales de salud, autenticación y usuarios en un ambiente aislado de pruebas. Valida privacidad de respuestas y tiempo de respuesta; 2000 ms es un umbral inicial, no un SLA.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('response time is within maxResponseTimeMs', function () {",
          "  const limit = Number(pm.environment.get('maxResponseTimeMs'));",
          "  pm.expect(limit).to.be.a('number').and.greaterThan(0);",
          "  pm.expect(pm.response.responseTime).to.be.at.most(limit);",
          "});",
          "pm.test('response is JSON and exposes no password data', function () {",
          "  pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
          "  const forbidden = ['password', 'passwordHash', 'password_hash', 'hash'];",
          "  function inspect(value) {",
          "    if (Array.isArray(value)) return value.forEach(inspect);",
          "    if (value && typeof value === 'object') Object.keys(value).forEach(function (key) {",
          "      pm.expect(forbidden).not.to.include(key);",
          "      inspect(value[key]);",
          "    });",
          "  }",
          "  inspect(pm.response.json());",
          "});"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:3000" },
    { "key": "email", "value": "" },
    { "key": "password", "value": "api-test-password" },
    { "key": "accessToken", "value": "" },
    { "key": "expiredToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "maxResponseTimeMs", "value": "2000" }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/salud"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('health endpoint responds with 200', function () { pm.response.to.have.status(200); });",
              "pm.test('health payload reports ok', function () { pm.expect(pm.response.json()).to.eql({ estado: 'ok', mensaje: 'API de CaféFlow funcionando correctamente' }); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Register customer",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('email', 'newman-' + Date.now() + '-' + Math.random().toString(16).slice(2) + '@example.test');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('registration creates a customer', function () { pm.response.to.have.status(201); });",
              "const user = pm.response.json().user;",
              "pm.test('registration returns the expected safe customer profile', function () { pm.expect(user).to.eql({ id: user.id, nombre: 'Newman Test User', email: pm.environment.get('email'), rol: 'cliente' }); });",
              "pm.environment.set('userId', user.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Newman Test User\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"rol\": \"admin\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "Reject duplicate registration",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Newman Test User\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('duplicate email is rejected', function () { pm.response.to.have.status(409); pm.expect(pm.response.json().message).to.be.a('string'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject invalid registration",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Invalid User\",\n  \"email\": \"invalid-email\",\n  \"password\": \"short\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('invalid registration is rejected', function () { pm.response.to.have.status(400); pm.expect(pm.response.json().message).to.be.a('string'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject incorrect login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"incorrect-password\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('incorrect credentials are rejected', function () { pm.response.to.have.status(401); pm.expect(pm.response.json().message).to.be.a('string'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Login customer",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('valid credentials return a token', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().access_token).to.be.a('string'); });",
              "pm.environment.set('accessToken', pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject unauthenticated profile",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/usuarios/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('profile requires authentication', function () { pm.response.to.have.status(401); pm.expect(pm.response.json().message).to.be.a('string'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject invalid-token profile",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer invalid-token" }
        ],
        "url": "{{baseUrl}}/api/usuarios/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('invalid token is rejected with 401', function () { pm.response.to.have.status(401); pm.expect(pm.response.json().message).to.be.a('string'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "PENDING - Reject expired-token profile",
      "disabled": true,
      "description": "Requires a JWT signed with the local test secret and expired at execution time.",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{expiredToken}}" }
        ],
        "url": "{{baseUrl}}/api/usuarios/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('expired token is rejected with 401', function () { pm.response.to.have.status(401); pm.expect(pm.response.json().message).to.be.a('string'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Get authenticated profile",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/api/usuarios/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('authenticated profile responds with 200', function () { pm.response.to.have.status(200); });",
              "pm.test('profile matches the registered customer', function () { pm.expect(pm.response.json().user.id).to.eql(pm.environment.get('userId')); pm.expect(pm.response.json().user.rol).to.eql('cliente'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject customer access to user list",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/api/usuarios"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('customer cannot access user administration', function () { pm.response.to.have.status(403); pm.expect(pm.response.json().message).to.be.a('string'); });"
            ]
          }
        }
      ]
    }
  ]
}
